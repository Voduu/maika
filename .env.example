# Copy this file to .env and fill in the values. Never commit .env.

# test or prod
ENVIRONMENT=test

# Bot token from the Discord Developer Portal (Bot > Reset Token).
DISCORD_TOKEN=

# Discord user ID of the owner (Developer Mode > right-click > Copy ID).
OWNER_ID=

# Starting values. A /config value overrides each one (design section 10).
# Comma-separated channel IDs Maika listens in.
LISTEN_CHANNELS=
# Channel ID for #bot-log.
LOG_CHANNEL_ID=

# Path to the SQLite database file.
DATABASE_PATH=var/maika.db

# Path to the rclone config file for the weekly offsite copy. rclone
# reads this variable itself. The file holds the storage keys, so keep
# it out of git. In Docker the appdata folder is mounted at /app/var:
# RCLONE_CONFIG=/app/var/rclone/rclone.conf
# Running locally, for example:
# RCLONE_CONFIG=var/rclone/rclone.conf

# Time zone for local times such as backups.time (an IANA name). The
# machine's own time zone is used when this is not set.
# TZ=America/Los_Angeles
